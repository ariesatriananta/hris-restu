
# development: Turnstile dilewati agar form publik dapat diuji di localhost.
# production: Turnstile wajib aktif dan konfigurasi di bawah wajib lengkap.
NODE_ENV=development
DATABASE_URL=mysql://root:password@localhost:3306/hris_restu
FRONTEND_ORIGIN=http://localhost:5173
PORT=3001
# Set 1 hanya saat production berjalan di belakang reverse proxy tepercaya seperti Hostinger.
TRUST_PROXY=1
JWT_ACCESS_SECRET=ganti-dengan-secret-minimal-32-karakter
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CONTRACT_LIFECYCLE_CRON_SECRET=ganti-dengan-secret-cron-minimal-32-karakter
ATTENDANCE_GO_LIVE_DATE=2026-08-01
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_KEY_PREFIX=hris-rsia/
# Ketiga nilai Turnstile hanya digunakan saat NODE_ENV=production.
RECRUITMENT_SITE_TOKENS_JSON={"replace-with-random-token-semarang":"SEMARANG","replace-with-random-token-klaten":"KLATEN","replace-with-random-token-jepara":"JEPARA"}
RECRUITMENT_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
RECRUITMENT_TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
RECRUITMENT_TURNSTILE_EXPECTED_HOSTNAME=hris.example.com
RECRUITMENT_R2_BUCKET_NAME=replace-with-private-r2-bucket
RECRUITMENT_R2_KEY_PREFIX=hris-rsia-private/recruitment/
